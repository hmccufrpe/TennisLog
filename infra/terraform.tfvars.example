# Copy to terraform.tfvars (git-ignored) to override defaults.
aws_region        = "us-east-1"
project           = "tennislog"
instance_type     = "t3.micro"
instance_count    = 2
db_instance_class = "db.t3.micro"

# AWS Academy Learner Lab: keep false and reuse LabInstanceProfile.
# Personal AWS account: set true to create the least-privilege role from iam.tf.
create_iam_resources  = false
instance_profile_name = "LabInstanceProfile"
